# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Gemini (structuring, analysis, feedback, chat). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: separate key for the keyword/news-summary step; falls back to GOOGLE_API_KEY
GEMINI_API_KEY=

# Optional: https://newsapi.org . If empty, the analysis simply skips the news context.
NEWS_API_KEY=

# Path to a Google Cloud service-account JSON with the Cloud Vision and Cloud
# Translation APIs enabled (used for handwritten-PDF OCR and translation).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: where OCR page images are written temporarily (default: pdf_output_threaded)
# OCR_OUTPUT_DIR=pdf_output_threaded
